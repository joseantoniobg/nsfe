# Copie para .env e preencha. O .env fica fora do git.

# Postgres do docker-compose.yml (porta 5433 para não conflitar com um Postgres local)
DATABASE_URL=postgres://nfe:nfe@localhost:5433/nfe

# Certificado digital A1 (e-CNPJ) usado para assinar a DPS e autenticar (mTLS) na Sefin Nacional.
# Coloque o arquivo em certs/ (pasta fora do git).
CERT_PFX_PATH=./certs/certificado.pfx
CERT_PFX_SENHA=

# 2 = Produção Restrita (testes, sem valor fiscal) | 1 = Produção
NFSE_AMBIENTE=2

# ---------- Opcionais ----------

# Leiaute da DPS. Por padrão: produção usa "atual" (XSD de 09/02/2026) e Produção Restrita usa "nt009".
# Quando a produção migrar para a NT 009, defina NFSE_LEIAUTE=nt009.
# NFSE_LEIAUTE=nt009

# CA extra (PEM) para validar o certificado do servidor da Sefin, se o Node não confiar na cadeia.
# NFSE_CA_PATH=./certs/ca.pem

# Algoritmo da assinatura XML: sha1 (padrão dos DF-e) ou sha256.
# NFSE_ASSINATURA=sha256

# URL alternativa da API da Sefin Nacional (apenas para testes com um servidor falso).
# NFSE_URL_SEFIN=https://127.0.0.1:8443
